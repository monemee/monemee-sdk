{
  "name": "@monemee/client",
  "version": "0.1.0",
  "description": "Lizenzschlüssel für Download-Software (Electron, Tauri, Browser-Erweiterungen, CLIs) – aktivieren, prüfen, offline mit signierten Antworten.",
  "type": "module",
  "main": "src/index.js",
